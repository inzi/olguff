# Olguff Configuration
# Copy this file to .env and customize as needed

# Path to llama.cpp directory
# If not set, defaults to ./llama.cpp in the project directory
# The script will offer to clone llama.cpp if it's not found
# LLAMACPP_PATH=/path/to/llama.cpp

# Download directories (optional)
# GGUF_DOWNLOAD_DIR=./dl
# SAFETENSORS_DOWNLOAD_DIR=./sf
